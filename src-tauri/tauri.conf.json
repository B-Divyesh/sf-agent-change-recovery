{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Change Recovery Ledger",
  "version": "0.1.0",
  "identifier": "in.sociobot.agent-change-recovery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build:site",
    "frontendDist": "../dist/site"
  },
  "app": {
    "windows": [{
      "title": "Change Recovery Ledger",
      "width": 1280,
      "height": 820,
      "minWidth": 760,
      "minHeight": 600,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Reverse selected agent changes without losing the rest.",
    "longDescription": "A local checkpoint ledger for inspecting, reversing, and exporting selected agent changes.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "10.13" },
    "linux": { "appimage": { "bundleMediaFramework": false } }
  }
}
